#version 450

layout(local_size_x = 256) in;

struct Particle {
    float pos_x, pos_y, pos_z;
    float vel_x, vel_y, vel_z;
    float screen_x, screen_y;
    float brightness;
    float _pad;
};

layout(std430, binding = 0) readonly buffer ParticleBufferIn {
    Particle particlesIn[];
};

layout(std430, binding = 1) buffer ParticleBufferOut {
    Particle particlesOut[];
};

layout(push_constant) uniform PushConstants {
    float dt;
    float gravity;
    float damping;
    uint particleCount;
    uint reinit;
    float singularity_x;
    float singularity_y;
    float singularity_z;
    float sin_a;
    float cos_a;
    float cameraDist;
    float cameraOffset;
    float aspectRatioX;
    float aspectRatioY;
    uint seed;
    float debugMode;
    float dbgScrX;
    float dbgScrY;
    float dbgBright;
} pc;

uint pcg_hash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randf(uint idx, uint s) {
    return float(pcg_hash(idx ^ s)) / float(0xFFFFFFFFu);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.particleCount) return;

    Particle p = particlesIn[idx];

    if (pc.debugMode > 0.5 && idx == 0u) {
        p.screen_x = pc.dbgScrX;
        p.screen_y = pc.dbgScrY;
        p.brightness = pc.dbgBright;
        particlesOut[0] = p;
        return;
    }

    if (pc.reinit != 0u) {
        float theta = randf(idx, pc.seed) * 6.2831853;
        float phi = randf(idx + 100000u, pc.seed) * 6.2831853;
        float scale = 0.004472136;

        p.pos_x = sin(phi) * scale;
        p.pos_y = sin(theta) * cos(phi) * scale;
        p.pos_z = cos(phi) * cos(theta) * scale;
        p.vel_x = 0.0;
        p.vel_y = 0.0;
        p.vel_z = 0.0;
        p.screen_x = 0.0;
        p.screen_y = 0.0;
        p.brightness = 0.0;
    } else {
        vec3 d = vec3(pc.singularity_x, pc.singularity_y, pc.singularity_z) - vec3(p.pos_x, p.pos_y, p.pos_z);
        float distSq = dot(d, d) + 1e-10;
        float force = pc.gravity / distSq * pc.dt;

        p.vel_x = (d.x * force - p.vel_x) * pc.damping + d.x * force;
        p.vel_y = (d.y * force - p.vel_y) * pc.damping + d.y * force;
        p.vel_z = (d.z * force - p.vel_z) * pc.damping + d.z * force;

        p.pos_x += p.vel_x;
        p.pos_y += p.vel_y;
        p.pos_z += p.vel_z;

        p.pos_x = clamp(p.pos_x, -1.0, 1.0);
        p.pos_y = clamp(p.pos_y, -1.0, 1.0);
        p.pos_z = clamp(p.pos_z, -1.0, 1.0);
    }

    float rot_z = pc.cos_a * p.pos_z + pc.sin_a * p.pos_x;
    float persp = pc.cameraDist / (rot_z + pc.cameraOffset);

    p.screen_x = (pc.cos_a * p.pos_x - pc.sin_a * p.pos_z) * persp * pc.aspectRatioX;
    p.screen_y = p.pos_y * persp * pc.aspectRatioY;

    float brightness = 1.0 - (rot_z + pc.cameraOffset) * 0.6666;
    if (brightness > 0.0 && brightness < 1.0) {
        brightness = brightness * 1.5 * brightness * brightness;
        brightness = clamp(brightness, 0.0, 1.0);
    }
    p.brightness = brightness;

    particlesOut[idx] = p;
}
