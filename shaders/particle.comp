#version 450

layout(local_size_x = 256) in;

struct Particle {
    float pos_x, pos_y, pos_z;
    float vel_x, vel_y, vel_z;
    float screen_x, screen_y;
    float brightness;
    float hue;
};

layout(std430, binding = 0) readonly buffer ParticleBufferIn {
    Particle particlesIn[];
};

layout(std430, binding = 1) buffer ParticleBufferOut {
    Particle particlesOut[];
};

layout(std430, binding = 2) readonly buffer SingBuffer {
    vec4 singPositions[8];
} singBuf;

layout(push_constant) uniform PushConstants {
    float dt;
    float gravity;
    float damping;
    float forceMult;
    uint particleCount;
    uint singCount;
    float comX;
    float comY;
    float comZ;
    float sin_a;
    float cos_a;
    float sin_elev;
    float cos_elev;
    float cameraDist;
    float cameraOffset;
    float aspectRatioX;
    float aspectRatioY;
    uint seed;
    float debugMode;
    float dbgScrX;
    float dbgScrY;
    float dbgBright;
    float velocityIntensity;
    float distanceIntensity;
} pc;

uint pcg_hash(uint v) {
    uint state = v * 747796405u + 2891336453u;
    uint word = ((state >> ((state >> 28u) + 4u)) ^ state) * 277803737u;
    return (word >> 22u) ^ word;
}

float randf(uint idx, uint s) {
    return float(pcg_hash(idx ^ s)) / float(0xFFFFFFFFu);
}

void main() {
    uint idx = gl_GlobalInvocationID.x;
    if (idx >= pc.particleCount) return;

    Particle p = particlesIn[idx];

    if (pc.debugMode > 0.5 && idx == 0u) {
        p.screen_x = pc.dbgScrX;
        p.screen_y = pc.dbgScrY;
        p.brightness = pc.dbgBright;
        particlesOut[0] = p;
        return;
    }

    // Sum gravity from all singularities
    vec3 totalForce = vec3(0.0);
    float nearestDistSq = 1e30;

    for (uint s = 0u; s < pc.singCount; s++) {
        vec3 ds = singBuf.singPositions[s].xyz - vec3(p.pos_x, p.pos_y, p.pos_z);
        float distSq = dot(ds, ds) + 1e-10;
        totalForce += ds * pc.forceMult / distSq;
        if (distSq < nearestDistSq) nearestDistSq = distSq;
    }

    p.vel_x = totalForce.x - p.vel_x * pc.damping;
    p.vel_y = totalForce.y - p.vel_y * pc.damping;
    p.vel_z = totalForce.z - p.vel_z * pc.damping;

    p.pos_x += p.vel_x;
    p.pos_y += p.vel_y;
    p.pos_z += p.vel_z;

    p.pos_x = clamp(p.pos_x, -1.0, 1.0);
    p.pos_y = clamp(p.pos_y, -1.0, 1.0);
    p.pos_z = clamp(p.pos_z, -1.0, 1.0);

    // Project using center of mass
    float ryX = pc.cos_a * p.pos_x - pc.sin_a * p.pos_z;
    float ryZ = pc.sin_a * p.pos_x + pc.cos_a * p.pos_z;
    float depth = pc.cos_elev * ryZ + pc.sin_elev * p.pos_y;
    float elevY = pc.cos_elev * p.pos_y - pc.sin_elev * ryZ;

    float persp = pc.cameraDist / (depth + pc.cameraOffset);

    p.screen_x = ryX * persp * pc.aspectRatioX;
    p.screen_y = elevY * persp * pc.aspectRatioY;

    float brightness = 1.0 - (depth + pc.cameraOffset) * 0.6666;
    if (brightness > 0.0 && brightness < 1.0) {
        brightness = brightness * 1.5 * brightness * brightness;
        brightness = clamp(brightness, 0.0, 1.0);
    }
    p.brightness = brightness;

    // Dual hypercolor: velocity + distance to nearest singularity
    float velMagSq = p.vel_x*p.vel_x + p.vel_y*p.vel_y + p.vel_z*p.vel_z;
    float velF = clamp(velMagSq * 100.0, 0.0, 1.0);
    float distF = clamp(1.0 / (nearestDistSq + 0.001), 0.0, 1.0);
    p.hue = clamp(velF * pc.velocityIntensity + distF * pc.distanceIntensity, 0.0, 1.0);

    particlesOut[idx] = p;
}
